---
# clang-tidy for the C++ written here, port/ (tools/check.py --tidy). The
# imported files are never analysed. The rule set is the Linux client's
# (its .clang-tidy, itself built on the framework's
# chromium/src/.clang-tidy: every bugprone and performance check,
# misc-include-cleaner and Chromium-style naming); keep the two the same.
# A check turned off below says why. Every finding is an error.
Checks: '-*,
         bugprone-*,
         -bugprone-easily-swappable-parameters,
         -bugprone-undelegated-constructor,
         -bugprone-macro-repeated-side-effects,
         -bugprone-misplaced-operator-in-strlen-in-alloc,
         -bugprone-misplaced-pointer-arithmetic-in-alloc,
         -bugprone-multiple-statement-macro,
         -bugprone-no-escape,
         -bugprone-posix-return,
         -bugprone-shared-ptr-array-mismatch,
         -bugprone-spuriously-wake-up-functions,
         -bugprone-standalone-empty,
         -bugprone-stringview-nullptr,
         -bugprone-suspicious-enum-usage,
         -bugprone-unhandled-exception-at-new,
         performance-*,
         -performance-enum-size,
         misc-include-cleaner,
         misc-misleading-identifier,
         misc-homoglyph,
         readability-identifier-naming,
         readability-redundant-member-init,
         clang-analyzer-core.uninitialized.*,
         google-build-explicit-make-pair,
         google-default-arguments,
         google-explicit-constructor,
         google-readability-casting,
         google-upgrade-googletest-case,
         modernize-avoid-bind,
         modernize-concat-nested-namespaces,
         modernize-loop-convert,
         modernize-make-shared,
         modernize-make-unique,
         modernize-redundant-void-arg,
         modernize-replace-random-shuffle,
         modernize-shrink-to-fit,
         modernize-use-bool-literals,
         modernize-use-default-member-init,
         modernize-use-emplace,
         modernize-use-equals-default,
         modernize-use-equals-delete,
         modernize-use-noexcept,
         modernize-use-nullptr,
         modernize-use-override,
         modernize-use-transparent-functors'
# Turned off:
# - bugprone-easily-swappable-parameters: fires on every function with two
#   parameters of one type (x, y, width, height); Chromium does not run it.
# - The other -bugprone-* lines: the framework's .clang-tidy lists them as
#   analysed and rejected for Chromium (false positives, or never useful).
# - performance-enum-size: asks for uint8_t bases on small enums; Chromium
#   style uses plain enum classes and the bytes do not matter here.
# - google-objc-avoid-nsobject-new (in the framework's list): no Objective-C
#   here.
WarningsAsErrors: '*'
CheckOptions:
  # Kept from the framework's .clang-tidy, without the base:: and absl:: names
  # (no base or absl here); the framework's StringNames and loop-convert
  # reverse range options are dropped for the same reason (they name base::).
  bugprone-assert-side-effect.AssertMacros: assert,DCHECK
  bugprone-dangling-handle.HandleClasses: ::std::basic_string_view;::std::span
  modernize-use-default-member-init.UseAssignment: 1
  modernize-use-transparent-functors.SafeMode: 1
  modernize-use-emplace.IgnoreImplicitConstructors: 1
  # Differs from the client: no googletest and no sysroot here. The
  # vendored BoringSSL's headers carry no IWYU pragmas.
  misc-include-cleaner.IgnoreHeaders: third_party.*
  # Chromium style naming (styleguide/c++/c++.md, Google style).
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  # Accessors and mutators may be named like variables: count(),
  # set_count(). clang-tidy cannot tell an accessor from any other method,
  # so every lower_case method passes; only mixed forms (doWork) fail.
  readability-identifier-naming.MethodIgnoredRegexp: '^(set_)?[a-z][a-z0-9_]*$'
  # main(). gtest's TEST() bodies are macro expansions, which the check
  # skips.
  readability-identifier-naming.FunctionIgnoredRegexp: '^main$'
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  # A local const may be spelled either way (count or kMaxCount).
  readability-identifier-naming.LocalConstantCase: aNy_CasE
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberSuffix: _
  # Constants fixed for the program's life: kName.
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # Include guards end in an underscore: CLIENT_PHI_LOG_H_.
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^[A-Z0-9_]+_H_$'
ExtraArgs:
  # Kept from the framework's .clang-tidy.
  - -Wno-unknown-pragmas
...
